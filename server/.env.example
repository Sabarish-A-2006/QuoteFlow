# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection
# Replace with your MongoDB Atlas connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/quoteflow?retryWrites=true&w=majority
# If left blank or MongoDB is not running locally, an in-memory MongoDB instance will be used automatically for seamless local development
MONGODB_URI=

# CORS Origin (comma-separated or single URL)
CLIENT_URL=http://localhost:5173

# External API Timeout (milliseconds)
API_TIMEOUT_MS=6000

# Duplicate Detection Window in seconds (e.g. 86400 = 24h, 0 to disable)
DUPLICATE_WINDOW_SECONDS=86400
